# Where the Express backend lives, INCLUDING the /api/v1 prefix.
# Development (default if you leave this out):
VITE_API_URL=http://localhost:5000/api/v1
# Production: set this in the Vercel dashboard (Project -> Settings -> Environment Variables)
# to your Render URL, then redeploy. Vite reads it at BUILD time.
# VITE_API_URL=https://your-backend.onrender.com/api/v1

# Optional: WebSocket server. Defaults to VITE_API_URL without "/api/v1".
# VITE_SOCKET_URL=http://localhost:5000
