# Server
PORT=5000
NODE_ENV=development

# Where the React app runs (used for CORS and the password-reset link)
FRONTEND_URL=http://localhost:5173

# Admin login
ADMIN_EMAIL=admin@institute.edu
ADMIN_PASSWORD=password123

# Secret used to sign login cookies. Leave empty in development and one is
# generated automatically (data/secret.key). Set a long random value in production.
SESSION_SECRET=
